{
    "name": "run",
    "version": "0.1.0",
    "private": true,
    "description": "A tiny running log that remembers what you wore at each temperature and tells you how to dress, or whether to stay inside.",
    "keywords": [],
    "license": "(MIT OR CC0-1.0)",
    "sideEffects": false,
    "type": "module",
    "scripts": {
        "build": "virmator frontend build",
        "compile": "virmator compile && tsc -p src/worker",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "start": "virmator frontend",
        "test": "virmator test node",
        "test:all": "npm run compile && runstorm --names tests,no-eval,spelling,format,deps,lint \"npm run test:coverage\" \"npm run test:no-eval\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:coverage": "npm run test coverage",
        "test:deps": "virmator deps check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:no-eval": "NODE_OPTIONS=--disallow-code-generation-from-strings npm test",
        "test:spelling": "virmator spellcheck",
        "test:update": "npm test update"
    },
    "dependencies": {
        "@augment-vir/common": "^32.2.4",
        "@bdemann/app-kit": "0.2.2",
        "@electrovir/local-storage-client": "^0.1.1",
        "@sinclair/typebox": "0.34.52",
        "date-vir": "^9.1.1",
        "element-vir": "^27.0.2",
        "object-shape-tester": "6.15.2",
        "spa-router-vir": "^6.8.0",
        "workbox-core": "^7.4.1",
        "workbox-precaching": "^7.4.1",
        "workbox-routing": "^7.4.1",
        "workbox-strategies": "^7.4.1"
    },
    "devDependencies": {
        "@augment-vir/assert": "^32.5.0",
        "@augment-vir/test": "^32.5.0",
        "@cloudflare/workers-types": "^5.0.0",
        "@eslint/js": "10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@types/node": "^26.6.5",
        "@typescript-eslint/eslint-plugin": "^8.71.1",
        "c8": "^12.0.0",
        "cspell": "^10.3.6",
        "dependency-cruiser": "^18.5.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^65.2.2",
        "eslint-plugin-playwright": "^2.12.1",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-unicorn": "^77.0.0",
        "istanbul-smart-text-reporter": "^1.1.5",
        "prettier": "3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.2",
        "prettier-plugin-jsdoc": "^1.8.1",
        "prettier-plugin-multiline-arrays": "^4.1.11",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.0.2",
        "prettier-plugin-sort-json": "^4.2.0",
        "prettier-plugin-toml": "^3.0.2",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1",
        "url-vir": "^2.2.2",
        "virmator": "^14.30.0",
        "vite": "^8.3.4",
        "vite-plugin-pwa": "^1.3.0",
        "wrangler": "^4.155.0"
    },
    "engines": {
        "node": ">=22"
    }
}
