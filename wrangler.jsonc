{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "run",
    "main": "src/worker/index.ts",
    "compatibility_date": "2026-10-30",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true,
    },
    "routes": [
        {
            "pattern": "run.demann.family",
            "custom_domain": true,
        },
    ],
    "vars": {
        "COMMIT": "dev",
    },
}
